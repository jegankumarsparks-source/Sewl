# Copy to .env. Names only; never commit real values.
# Optional: a NEW free Helius key (https://helius.dev). If unset, keyless public RPC is used (stricter limits).
HELIUS_API_KEY=
# Optional: Telegram alerts. Create a NEW bot with @BotFather, then send /start to it and get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set true only after you reviewed and approved the exit policy in config/experiment.json
EXIT_POLICY_APPROVED=true
